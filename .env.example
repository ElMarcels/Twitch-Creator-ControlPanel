# ============================================
# Twitch Channel Moderator Dashboard - Config
# ============================================
# 
# INSTRUCCIONES:
# 1. Ve a https://dev.twitch.tv/console/apps
# 2. Crea una nueva aplicación (tipo Confidential)
# 3. Copia el Client ID y Client Secret aqui
# 4. En "OAuth Redirect URLs" agrega:
#    - Local: http://localhost:3000/auth/twitch/callback
#    - Produccion: https://TU-DOMINIO.vercel.app/auth/twitch/callback
#
# Permisos necesarios (scopes):
# - user:read:email
# - channel:moderate
# - chat:edit
# - chat:read
# - moderator:manage:banned_users
# - moderator:read:chatters
# - moderator:manage:announcements
# - moderator:manage:chat_settings
# - moderator:read:followers
# - channel:manage:moderators
# - channel:manage:vips
# - channel:manage:polls
# - channel:manage:predictions
# - channel:read:predictions
# - channel:manage:raids
# - channel:read:hype_train
# - channel:manage:redemptions
# - channel:read:redemptions
# - channel:read:stream_key
# - user:edit:follows
# - user:read:broadcast
# - user:edit:broadcast
# - moderation:read
# - bits:read
# - user:write:chat

TWITCH_CLIENT_ID=tu_client_id
TWITCH_CLIENT_SECRET=tu_client_secret
JWT_SECRET=cambia_esta_secreta_aqui
PORT=3000

# Produccion: se establece automaticamente en Vercel
# Local: deja esta linea para que use localhost
# BASE_URL=https://TU-DOMINIO.vercel.app

# ============================================
# Nightbot Integration (Opcional)
# ============================================
# 1. Ve a https://nightbot.tv/account/applications
# 2. Crea una aplicacion nueva
# 3. En "Redirect URL" agrega:
#    - Local: http://localhost:3000/auth/nightbot/callback
#    - Produccion: https://TU-DOMINIO.vercel.app/auth/nightbot/callback
# 4. Copia el Client ID y genera un Client Secret
#
# Scopes necesarios: commands commands_default channel channel_send

NIGHTBOT_CLIENT_ID=tu_nightbot_client_id
NIGHTBOT_CLIENT_SECRET=tu_nightbot_client_secret

# ============================================
# Kick Integration (Opcional)
# ============================================
# 1. Ve a https://kick.com/developers (o dashboard de apps de Kick)
# 2. Crea una aplicacion y registra como "Redirect URL":
#    - Local: http://localhost:3000/auth/kick/callback
#    - Produccion: https://TU-DOMINIO.vercel.app/auth/kick/callback
# 3. Copia el Client ID y Client Secret aqui
#
# Scopes necesarios: channel:read channel:write chat:write events:subscribe
# moderation:ban moderation:chat_message:manage streamkey:read user:read

KICK_CLIENT_ID=tu_kick_client_id
KICK_CLIENT_SECRET=tu_kick_client_secret

# ============================================
# TikTok Integration (Opcional)
# ============================================
# 1. Ve a https://developers.tiktok.com
# 2. Crea una aplicacion (Login Kit / Live) y registra como "Redirect URI":
#    - Local: http://localhost:3000/auth/tiktok/callback
#    - Produccion: https://TU-DOMINIO.vercel.app/auth/tiktok/callback
# 3. Solicita y aprueba los scopes (Live Stream Kit para funciones de directo):
#    user.info.basic, video.list, live.manage, live.verify,
#    comment.read, comment.manage
# 4. Copia el Client Key y Client Secret aqui

TIKTOK_CLIENT_ID=tu_tiktok_client_id
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret
